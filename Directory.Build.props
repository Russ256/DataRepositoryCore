<Project>
  <PropertyGroup>
    <Version>11.0.0-rc.3.26522.148</Version>
    <Nullable>enable</Nullable>
    <TargetFramework>net11.0</TargetFramework>
    <Product>DataRepositoryCore</Product>
    <Authors>Russell Wilkins</Authors>
    <Description>Generic Data Repositories for Entity Framework</Description>
    <Copyright>Russell Wilkins</Copyright>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Russ256/DataRepositoryCore</RepositoryUrl>
    <PackageProjectUrl>https://github.com/Russ256/DataRepositoryCore</PackageProjectUrl>
    <RootNamespace>DataRepositoryCore</RootNamespace>
  </PropertyGroup>
</Project>
